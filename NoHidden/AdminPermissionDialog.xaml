<Window x:Class="NoHidden.AdminPermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AdminPermissionTitle}"
        Width="520"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0B1220"
        FontFamily="pack://application:,,,/#Vazirmatn"
        Icon="pack://application:,,,/favicon.ico"
        FlowDirection="LeftToRight">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ContentRoot"
                    Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        FlowDirection="LeftToRight">
                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#2A1C0A"
                        BorderBrush="#7A4E0B"
                        BorderThickness="1"
                        Margin="0,0,16,0">
                    <TextBlock Text="!"
                               Foreground="#F59E0B"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AdminPermissionTitle}"
                               Foreground="#F8FAFC"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource AdminPermissionSubtitle}"
                               Foreground="#AAB6CA"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{DynamicResource AdminPermissionDescription}"
                       Foreground="#C5D0E0"
                       FontSize="14"
                       LineHeight="23"
                       TextWrapping="Wrap"
                       Margin="0,22,0,0" />

            <Border Background="#0F1D31"
                    BorderBrush="#1D3554"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,18,0,0">
                <TextBlock Text="{DynamicResource AdminPermissionNote}"
                           Foreground="#9FB4D1"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0"
                    FlowDirection="LeftToRight">
            <Button Content="{DynamicResource Cancel}"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Background="#182236"
                    Foreground="#F8FAFC"
                    BorderBrush="#31415E"
                    BorderThickness="1"
                    Cursor="Hand" />

            <Button Content="{DynamicResource RestartAsAdministrator}"
                    MinWidth="180"
                    Height="38"
                    IsDefault="True"
                    Click="Restart_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
