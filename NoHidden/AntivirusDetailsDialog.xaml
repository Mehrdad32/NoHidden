<Window x:Class="NoHidden.AntivirusDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AntivirusDetailsTitle}"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0B1220"
        FontFamily="pack://application:,,,/#Vazirmatn"
        Icon="pack://application:,,,/favicon.ico"
        FlowDirection="LeftToRight">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ContentRoot"
                    Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        FlowDirection="LeftToRight">
                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#0F2B1E"
                        BorderBrush="#1E6D46"
                        BorderThickness="1"
                        Margin="0,0,16,0">
                    <TextBlock Text="i"
                               Foreground="#22C55E"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AntivirusDetailsTitle}"
                               Foreground="#F8FAFC"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource AntivirusDetailsSubtitle}"
                               Foreground="#AAB6CA"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Background="#121A2A"
                    BorderBrush="#22304A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource AntivirusProductLabel}"
                               Foreground="#AAB6CA"
                               Margin="0,0,18,10" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               x:Name="ProductNameText"
                               Foreground="#F8FAFC"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1"
                               Text="{DynamicResource AntivirusSourceLabel}"
                               Foreground="#AAB6CA"
                               Margin="0,0,18,10" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{DynamicResource AntivirusSourceValue}"
                               Foreground="#F8FAFC"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource AntivirusStateCodeLabel}"
                               Foreground="#AAB6CA"
                               Margin="0,0,18,0" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               x:Name="StateCodeText"
                               Foreground="#F8FAFC"
                               FontFamily="Consolas" />
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource AntivirusDetailsExplanation}"
                       Foreground="#C5D0E0"
                       FontSize="13"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0" />

            <Border Background="#0F1D31"
                    BorderBrush="#1D3554"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource AntivirusTechnicalNote}"
                           Foreground="#9FB4D1"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0"
                    FlowDirection="LeftToRight">
            <Button Content="{DynamicResource Close}"
                    Width="96"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Close_Click"
                    Background="#182236"
                    Foreground="#F8FAFC"
                    BorderBrush="#31415E"
                    BorderThickness="1"
                    Cursor="Hand" />

            <Button Content="{DynamicResource LearnMoreOnline}"
                    MinWidth="150"
                    Height="38"
                    Click="LearnMore_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
