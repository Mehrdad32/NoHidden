<Window x:Class="NoHidden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoHidden"
        Title="{DynamicResource AppTitle}"
        Width="1080"
        Height="760"
        MinWidth="920"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        Icon="pack://application:,,,/favicon.ico"
        FontFamily="pack://application:,,,/#Vazirmatn"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="LeftToRight">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#121A2A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#22304A" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB6CA" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#182236" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#31415E" />
        <SolidColorBrush x:Key="InputHoverBrush" Color="#22304A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#182236" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#31415E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#22304A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#7FB0FF" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource InputHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#29456F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    MouseLeftButtonDown="Border_MouseLeftButtonDown"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <ToggleButton Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"
                                                  HorizontalAlignment="Right"
                                                  Width="34"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Fill="#AAB6CA"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0 Z" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#182236"
                                        BorderBrush="#31415E"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"
                                        MaxHeight="260">
                                    <ScrollViewer Margin="4"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#49648C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#4F8FFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder"
                                        Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                FlowDirection="LeftToRight"
                Background="#0F1728"
                BorderBrush="#1C2940"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="12"
                            Background="#070B13"
                            Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/logo.png"
                               Width="44"
                               Height="44"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource AppTitle}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border Background="#1B2A43"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource AppVersion}"
                                           FlowDirection="{Binding ContentFlowDirection}"
                                           FontSize="11"
                                           Foreground="#9FB0CA" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource AppSubtitle}"
                                   FlowDirection="{Binding ContentFlowDirection}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Language}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox x:Name="LanguageComboBox"
                              Width="145"
                              SelectedValuePath="Tag"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Tag="en-US" Content="English" />
                        <ComboBoxItem Tag="fa-IR" Content="فارسی" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              FlowDirection="{Binding ContentFlowDirection}"
              Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource WindowsProtection}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <Border Grid.Column="1"
                                    BorderBrush="{Binding ProtectionStatusColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding ProtectionBadgeText}"
                                           Foreground="{Binding ProtectionStatusColor}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding ProtectionStatusColor}"
                                     VerticalAlignment="Top"
                                     Margin="0,5,9,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AutorunStatus}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       LineHeight="20" />
                        </Grid>

                        <Button Grid.Row="2"
                                Content="{DynamicResource ProtectWindows}"
                                Command="{Binding DisableAutorunCommand}"
                                Visibility="{Binding DisableAutoRunButtonVisibility}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AntivirusProtection}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <Border Grid.Column="1"
                                    BorderBrush="{Binding AntivirusStatusColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding AntivirusBadgeText}"
                                           Foreground="{Binding AntivirusStatusColor}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding AntivirusStatusColor}"
                                     VerticalAlignment="Top"
                                     Margin="0,5,9,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AntivirusStatus}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       LineHeight="20" />
                        </Grid>

                        <Button Grid.Row="2"
                                Content="{DynamicResource LearnMore}"
                                Command="{Binding OpenAntivirusInfoCommand}"
                                Visibility="{Binding LearnMoreButtonVisibility}"
                                Style="{StaticResource LinkButtonStyle}"
                                Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource CardStyle}"
                        MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource UsbDevice}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding UsbStatusColor}"
                                     VerticalAlignment="Top"
                                     Margin="0,5,9,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding UsbStatus}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UsbDetails}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           LineHeight="19"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,22,0">
                            <TextBlock Text="{DynamicResource UsbScanner}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SelectUsbDrive}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RemovableDrives}"
                                  SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                                  MinWidth="250"
                                  MaxWidth="430"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding CanStartScan}" />

                        <Button Grid.Column="2"
                                Command="{Binding RefreshDrivesCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource RefreshDrives}"
                                Margin="10,0,0,0"
                                IsEnabled="{Binding CanStartScan}">
                            <Image Source="pack://application:,,,/refresh.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="3"
                                Content="{DynamicResource ScanUsb}"
                                Command="{Binding StartScanCommand}"
                                IsEnabled="{Binding CanStartScan}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="12,0,0,0"
                                MinWidth="120" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#22304A" />

                    <Grid Grid.Row="2"
                          MinHeight="220">

                        <StackPanel Visibility="{Binding ScanEmptyStateVisibility}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="650">
                            <Border Width="72"
                                    Height="72"
                                    CornerRadius="36"
                                    Background="#152540"
                                    BorderBrush="#28436D"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="USB"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#79A9FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight" />
                            </Border>

                            <TextBlock Text="{Binding EmptyStateTitle}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,16,0,0" />

                            <TextBlock Text="{Binding EmptyStateDescription}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       LineHeight="22"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ScanProgressVisibility}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Margin="40,0">
                            <TextBlock Text="{DynamicResource UsbScanner}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />

                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Margin="0,18,0,14"
                                         Background="#182236"
                                         Foreground="#3B82F6" />

                            <TextBlock Text="{Binding ScanProgressText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="44" />

                            <Button Content="{DynamicResource CancelScan}"
                                    Command="{Binding CancelScanCommand}"
                                    Visibility="{Binding CancelScanVisibility}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    MinWidth="100" />
                        </StackPanel>

                        <Grid Visibility="{Binding ScanResultsVisibility}"
                              Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ScanResults}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScanSummaryText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource RestoreAllHidden}"
                                        Command="{Binding RestoreAllVisibleItemsCommand}"
                                        Visibility="{Binding RestoreAllVisibility}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ScanFindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F1728"
                                                    BorderBrush="#22304A"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="12"
                                                    Margin="0,0,0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            BorderBrush="{Binding SeverityColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="8,4"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding SeverityText}"
                                                                   Foreground="{Binding SeverityColor}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding TypeText}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />

                                                        <TextBlock Text="{Binding Path}"
                                                                   Foreground="#7FB0FF"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <TextBlock Text="{Binding ReasonText}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   LineHeight="19"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Content="{Binding RestoreActionText}"
                                                            Command="{Binding DataContext.RestoreVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding RestoreActionVisibility}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            VerticalAlignment="Center"
                                                            Margin="14,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="#0F1D31"
                    BorderBrush="#1D3554"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#60A5FA"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Foreground="#B9C8DD"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
