<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">NoHidden</sys:String>
    <sys:String x:Key="AppVersion">v3.0.0 (Development)</sys:String>
    <sys:String x:Key="SystemInfo">System information</sys:String>
    <sys:String x:Key="Error">Error: {0}</sys:String>

    <sys:String x:Key="AutorunDisabled">AutoRun is disabled</sys:String>
    <sys:String x:Key="AutorunEnabled">AutoRun is enabled</sys:String>
    <sys:String x:Key="AutoPlayEnabled">AutoPlay is enabled</sys:String>
    <sys:String x:Key="AutoPlayDisabledGlobally">AutoPlay is disabled</sys:String>
    <sys:String x:Key="AutorunProtectionEnabled">AutoRun and AutoPlay have been disabled for this Windows user.</sys:String>

    <sys:String x:Key="UnknownAntivirus">Unknown antivirus</sys:String>
    <sys:String x:Key="AntivirusStatus">Antivirus detected: {0} (state 0x{1})</sys:String>
    <sys:String x:Key="NotInstalled">No antivirus product was detected by Windows Security Center.</sys:String>

    <sys:String x:Key="Messages">Messages</sys:String>
    <sys:String x:Key="OperationsGroupHeader">USB drive</sys:String>
    <sys:String x:Key="SelectUsbDrive">Select USB drive:</sys:String>
    <sys:String x:Key="Problems">Scan results</sys:String>
    <sys:String x:Key="ScanNotStarted">No scan has been started yet.</sys:String>
    <sys:String x:Key="NoRemovableDevices">No removable USB drive is currently available.</sys:String>
    <sys:String x:Key="RefreshDrives">Refresh drives</sys:String>
    <sys:String x:Key="Language">Language / زبان</sys:String>

    <sys:String x:Key="ClickToDisableAutoRun">Disable AutoRun &amp; AutoPlay</sys:String>
    <sys:String x:Key="ClickToLearnMoreAboutAntiVirus">Why antivirus protection matters</sys:String>
</ResourceDictionary>
