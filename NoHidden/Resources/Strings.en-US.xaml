<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">NoHidden</sys:String>
    <sys:String x:Key="AppSubtitle">USB malware recovery &amp; protection</sys:String>
    <sys:String x:Key="AppVersion">v3.0.0 Development</sys:String>

    <sys:String x:Key="WindowsProtection">Windows protection</sys:String>
    <sys:String x:Key="AntivirusProtection">Antivirus</sys:String>
    <sys:String x:Key="UsbDevice">USB device</sys:String>
    <sys:String x:Key="UsbScanner">USB scanner</sys:String>
    <sys:String x:Key="ScanResults">Results</sys:String>

    <sys:String x:Key="Protected">Protected</sys:String>
    <sys:String x:Key="Attention">Needs attention</sys:String>
    <sys:String x:Key="Detected">Detected</sys:String>
    <sys:String x:Key="NotDetected">Not detected</sys:String>
    <sys:String x:Key="Unknown">Unknown</sys:String>

    <sys:String x:Key="AutorunProtectionActive">AutoRun and AutoPlay are disabled for this Windows user.</sys:String>
    <sys:String x:Key="AutorunProtectionRecommended">AutoRun or AutoPlay is enabled. Protection is recommended before opening unknown USB drives.</sys:String>
    <sys:String x:Key="ProtectionStatusUnavailable">Windows protection status could not be checked.</sys:String>
    <sys:String x:Key="AutorunProtectionEnabled">Windows USB protection was enabled successfully.</sys:String>
    <sys:String x:Key="ProtectWindows">Protect Windows</sys:String>

    <sys:String x:Key="UnknownAntivirus">Unknown antivirus</sys:String>
    <sys:String x:Key="AntivirusDetected">Windows reports {0} as an installed antivirus product.</sys:String>
    <sys:String x:Key="NotInstalled">Windows Security Center did not report an installed antivirus product.</sys:String>
    <sys:String x:Key="AntivirusStatusUnavailable">Antivirus status could not be checked.</sys:String>
    <sys:String x:Key="LearnMore">Details</sys:String>

    <sys:String x:Key="UsbNotConnected">No USB drive detected</sys:String>
    <sys:String x:Key="UsbConnectHint">Connect a removable USB drive to begin.</sys:String>
    <sys:String x:Key="SelectUsbDrive">Choose a USB drive</sys:String>
    <sys:String x:Key="RefreshDrives">Refresh drives</sys:String>
    <sys:String x:Key="UsbRefreshed">USB drive list refreshed.</sys:String>
    <sys:String x:Key="NoRemovableDevices">No removable USB drive is currently available.</sys:String>

    <sys:String x:Key="EmptyStateNoUsbTitle">Connect a USB drive</sys:String>
    <sys:String x:Key="EmptyStateNoUsbDescription">NoHidden will look for hidden files, suspicious shortcuts, autorun entries and potentially dangerous scripts.</sys:String>
    <sys:String x:Key="EmptyStateReadyTitle">Ready to scan</sys:String>
    <sys:String x:Key="EmptyStateReadyDescription">The selected drive is ready. Scanning will not modify files unless you explicitly choose a repair action.</sys:String>
    <sys:String x:Key="ScanUsb">Scan USB</sys:String>
    <sys:String x:Key="ScannerComingNext">The new scanner engine is the next development phase.</sys:String>

    <sys:String x:Key="ReadyStatus">NoHidden is ready. No files will be changed without your confirmation.</sys:String>
    <sys:String x:Key="Language">Language</sys:String>
    <sys:String x:Key="Status">Status</sys:String>
    <sys:String x:Key="Error">Error: {0}</sys:String>

    <sys:String x:Key="ApplicationAlreadyRunning">NoHidden is already running.</sys:String>

    <sys:String x:Key="AdminPermissionTitle">Administrator permission required</sys:String>
    <sys:String x:Key="AdminPermissionSubtitle">Required to change Windows protection settings</sys:String>
    <sys:String x:Key="AdminPermissionDescription">To disable AutoRun and AutoPlay system-wide, NoHidden needs to restart once with Administrator permission. After you confirm, this window will close, the standard Windows UAC prompt will appear, and NoHidden will continue the protection step automatically.</sys:String>
    <sys:String x:Key="AdminPermissionNote">NoHidden only changes Windows AutoRun and AutoPlay policy in this step. It does not delete or modify files on any USB drive.</sys:String>
    <sys:String x:Key="RestartAsAdministrator">Restart as Administrator</sys:String>
    <sys:String x:Key="Cancel">Cancel</sys:String>
    <sys:String x:Key="AdminPermissionCanceled">The operation was canceled. No settings were changed.</sys:String>
    <sys:String x:Key="AdminElevationFailed">NoHidden is not running with Administrator permission, so protection could not be applied.</sys:String>
    <sys:String x:Key="AdminElevationRequired">Administrator permission is required to apply these settings.</sys:String>

    <sys:String x:Key="AntivirusDetailsTitle">Antivirus details</sys:String>
    <sys:String x:Key="AntivirusDetailsSubtitle">Information reported by Windows about the security product</sys:String>
    <sys:String x:Key="AntivirusProductLabel">Product</sys:String>
    <sys:String x:Key="AntivirusSourceLabel">Information source</sys:String>
    <sys:String x:Key="AntivirusSourceValue">Windows Security Center</sys:String>
    <sys:String x:Key="AntivirusStateCodeLabel">Technical state code</sys:String>
    <sys:String x:Key="AntivirusDetailsExplanation">NoHidden uses Windows Security Center to identify the registered security product. Detection means Windows recognizes the product as antivirus software; by itself, this does not guarantee that every protection feature, definition update, or real-time protection setting is enabled.</sys:String>
    <sys:String x:Key="AntivirusTechnicalNote">The state code is shown only for diagnostics. It is not a security score or health percentage.</sys:String>
    <sys:String x:Key="NoAntivirusProduct">No antivirus product detected</sys:String>
    <sys:String x:Key="NotAvailable">Not available</sys:String>
    <sys:String x:Key="Close">Close</sys:String>
    <sys:String x:Key="LearnMoreOnline">Read more online</sys:String>

    <sys:String x:Key="ScanningStatus">Scanning the selected USB drive. No files are being modified.</sys:String>
    <sys:String x:Key="ScanningProgress">Scanned {0} items — {1}</sys:String>
    <sys:String x:Key="CancelScan">Cancel</sys:String>
    <sys:String x:Key="ScanSummary">{0} items scanned · {1} findings · {2} recoverable · {3} high risk</sys:String>
    <sys:String x:Key="ScanCompletedClean">Scan completed. No suspicious or hidden user items were found.</sys:String>
    <sys:String x:Key="ScanCompletedWithFindings">Scan completed. Review the findings before taking any repair action.</sys:String>
    <sys:String x:Key="ScanCleanTitle">No issues found</sys:String>
    <sys:String x:Key="ScanCleanDescription">NoHidden did not find hidden user content or suspicious USB malware patterns in this scan.</sys:String>
    <sys:String x:Key="ScanCanceledTitle">Scan canceled</sys:String>
    <sys:String x:Key="ScanCanceledDescription">The scan was stopped. No files were changed.</sys:String>
    <sys:String x:Key="ScanCanceledStatus">USB scan canceled. No files were changed.</sys:String>
    <sys:String x:Key="ScanFailedTitle">Scan could not finish</sys:String>
    <sys:String x:Key="ScanFailedDescription">Check that the USB drive is still connected and accessible, then try again.</sys:String>
    <sys:String x:Key="RestoreVisibility">Restore visibility</sys:String>
    <sys:String x:Key="RestoreAllHidden">Restore all hidden items</sys:String>
    <sys:String x:Key="VisibilityRestored">The selected item is visible again.</sys:String>
    <sys:String x:Key="VisibilityRestoredMultiple">All detected hidden user items were restored successfully.</sys:String>
    <sys:String x:Key="VisibilityRestorePartial">{0} items restored; {1} could not be restored.</sys:String>

    <sys:String x:Key="SeverityInfo">Recovery</sys:String>
    <sys:String x:Key="SeverityLow">Low</sys:String>
    <sys:String x:Key="SeverityMedium">Suspicious</sys:String>
    <sys:String x:Key="SeverityHigh">High risk</sys:String>
    <sys:String x:Key="SeverityCritical">Critical</sys:String>

    <sys:String x:Key="FindingTypeHiddenItem">Hidden item</sys:String>
    <sys:String x:Key="FindingTypeAutorun">Autorun file</sys:String>
    <sys:String x:Key="FindingTypeSuspiciousScript">Script</sys:String>
    <sys:String x:Key="FindingTypeSuspiciousExecutable">Executable</sys:String>
    <sys:String x:Key="FindingTypeDoubleExtension">Double extension</sys:String>
    <sys:String x:Key="FindingTypeFolderMasquerading">Folder impersonation</sys:String>
    <sys:String x:Key="FindingTypeSuspiciousShortcut">Shortcut</sys:String>
    <sys:String x:Key="FindingTypeUnknown">Finding</sys:String>

    <sys:String x:Key="ReasonHiddenAttributes">This item has Hidden or System attributes. NoHidden can safely restore its visibility without changing its contents.</sys:String>
    <sys:String x:Key="ReasonAutorunPresent">autorun.inf exists on the USB drive. Its presence is not automatically malware, but it deserves review.</sys:String>
    <sys:String x:Key="ReasonAutorunSuspicious">autorun.inf contains a command that can launch an executable, script or command interpreter.</sys:String>
    <sys:String x:Key="ReasonSuspiciousScript">This script type can execute commands. It is flagged for review; NoHidden will not delete it automatically.</sys:String>
    <sys:String x:Key="ReasonSuspiciousExecutable">This executable is in a location commonly abused by USB malware. It is flagged for review only.</sys:String>
    <sys:String x:Key="ReasonHiddenDangerous">This executable or script is hidden/system-marked, which is a strong USB-malware indicator.</sys:String>
    <sys:String x:Key="ReasonDoubleExtension">The filename uses a document/media extension followed by an executable extension, a common disguise technique.</sys:String>
    <sys:String x:Key="ReasonFolderMasquerading">An executable or shortcut has the same name as a nearby folder, which can be used to impersonate that folder.</sys:String>
    <sys:String x:Key="ReasonSuspiciousShortcutCommand">This shortcut launches a command interpreter such as CMD, PowerShell or Windows Script Host.</sys:String>
    <sys:String x:Key="ReasonSuspiciousShortcutPayload">This shortcut points to a hidden or executable/script payload.</sys:String>
    <sys:String x:Key="ReasonRootShortcut">A shortcut was found at the USB root. It is flagged for review because shortcut malware commonly uses this pattern.</sys:String>

    <sys:String x:Key="AntivirusDetailsToolTip">Show antivirus details</sys:String>
    <sys:String x:Key="ScanWithDefender">Defender scan</sys:String>
    <sys:String x:Key="ScanWithDefenderToolTip">Scan this file with Microsoft Defender without automatic remediation</sys:String>
    <sys:String x:Key="NeutralizeFile">Neutralize</sys:String>
    <sys:String x:Key="NeutralizeFileToolTip">Rename the file with a .nohidden-disabled suffix so it cannot be launched normally</sys:String>
    <sys:String x:Key="NeutralizeConfirmationTitle">Neutralize file</sys:String>
    <sys:String x:Key="NeutralizeConfirmation">The file “{0}” will not be deleted. It will be renamed with the safe .nohidden-disabled suffix. Continue?</sys:String>
    <sys:String x:Key="FileNeutralized">The file was neutralized as “{0}”.</sys:String>
    <sys:String x:Key="DefenderScanStarting">Microsoft Defender is scanning the file. Windows UAC may appear if elevated access is required.</sys:String>
    <sys:String x:Key="DefenderScanNoAction">Microsoft Defender finished the scan without reporting an immediate action requirement.</sys:String>
    <sys:String x:Key="DefenderScanAttention">Microsoft Defender reported a detection, required action, or scan problem. Do not run the file; neutralize it if you are unsure.</sys:String>
    <sys:String x:Key="DefenderScanFailed">Microsoft Defender could not complete the file scan.</sys:String>

    <sys:String x:Key="CheckVirusTotal">VirusTotal</sys:String>
    <sys:String x:Key="CheckVirusTotalToolTip">Calculate SHA-256 locally and open the matching VirusTotal report; the file itself is not uploaded</sys:String>
    <sys:String x:Key="HashingFile">Calculating SHA-256 for the online reputation check…</sys:String>
    <sys:String x:Key="VirusTotalOpened">The SHA-256 report was opened in VirusTotal. The file itself was not uploaded.</sys:String>
</ResourceDictionary>
