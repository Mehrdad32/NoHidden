<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">NoHidden</sys:String>
    <sys:String x:Key="AppSubtitle">بازیابی و محافظت در برابر بدافزارهای USB</sys:String>
    <sys:String x:Key="AppVersion">نسخه ۳.۰.۰ - در حال توسعه</sys:String>

    <sys:String x:Key="WindowsProtection">محافظت ویندوز</sys:String>
    <sys:String x:Key="AntivirusProtection">آنتی‌ویروس</sys:String>
    <sys:String x:Key="UsbDevice">حافظه USB</sys:String>
    <sys:String x:Key="UsbScanner">بررسی حافظه USB</sys:String>
    <sys:String x:Key="ScanResults">نتیجه بررسی</sys:String>

    <sys:String x:Key="Protected">محافظت‌شده</sys:String>
    <sys:String x:Key="Attention">نیازمند توجه</sys:String>
    <sys:String x:Key="Detected">شناسایی شد</sys:String>
    <sys:String x:Key="NotDetected">شناسایی نشد</sys:String>
    <sys:String x:Key="Unknown">نامشخص</sys:String>

    <sys:String x:Key="AutorunProtectionActive">AutoRun و AutoPlay برای کاربر فعلی ویندوز غیرفعال هستند.</sys:String>
    <sys:String x:Key="AutorunProtectionRecommended">AutoRun یا AutoPlay فعال است. بهتر است قبل از باز کردن فلش‌های ناشناس محافظت ویندوز فعال شود.</sys:String>
    <sys:String x:Key="ProtectionStatusUnavailable">وضعیت محافظت ویندوز قابل بررسی نبود.</sys:String>
    <sys:String x:Key="AutorunProtectionEnabled">محافظت USB ویندوز با موفقیت فعال شد.</sys:String>
    <sys:String x:Key="ProtectWindows">ایمن‌سازی ویندوز</sys:String>

    <sys:String x:Key="UnknownAntivirus">آنتی‌ویروس ناشناخته</sys:String>
    <sys:String x:Key="AntivirusDetected">ویندوز، {0} را به‌عنوان آنتی‌ویروس نصب‌شده شناسایی کرده است.</sys:String>
    <sys:String x:Key="NotInstalled">Windows Security Center هیچ آنتی‌ویروس نصب‌شده‌ای گزارش نکرد.</sys:String>
    <sys:String x:Key="AntivirusStatusUnavailable">وضعیت آنتی‌ویروس قابل بررسی نبود.</sys:String>
    <sys:String x:Key="LearnMore">جزئیات</sys:String>

    <sys:String x:Key="UsbNotConnected">هیچ حافظه USB شناسایی نشد</sys:String>
    <sys:String x:Key="UsbConnectHint">برای شروع یک حافظه USB قابل‌حذف متصل کنید.</sys:String>
    <sys:String x:Key="SelectUsbDrive">انتخاب حافظه USB</sys:String>
    <sys:String x:Key="RefreshDrives">بازخوانی حافظه‌ها</sys:String>
    <sys:String x:Key="UsbRefreshed">فهرست حافظه‌های USB بازخوانی شد.</sys:String>
    <sys:String x:Key="NoRemovableDevices">در حال حاضر هیچ حافظه USB قابل‌حذفی در دسترس نیست.</sys:String>

    <sys:String x:Key="EmptyStateNoUsbTitle">یک حافظه USB متصل کنید</sys:String>
    <sys:String x:Key="EmptyStateNoUsbDescription">NoHidden فایل‌های مخفی‌شده، میانبرهای مشکوک، فایل‌های Autorun و اسکریپت‌های بالقوه خطرناک را بررسی خواهد کرد.</sys:String>
    <sys:String x:Key="EmptyStateReadyTitle">آماده بررسی</sys:String>
    <sys:String x:Key="EmptyStateReadyDescription">حافظه انتخاب‌شده آماده است. اسکن هیچ فایلی را تغییر نمی‌دهد مگر اینکه خودتان عملیات ترمیم را تأیید کنید.</sys:String>
    <sys:String x:Key="ScanUsb">بررسی حافظه USB</sys:String>
    <sys:String x:Key="ScannerComingNext">موتور جدید اسکن در فاز بعدی توسعه اضافه می‌شود.</sys:String>

    <sys:String x:Key="ReadyStatus">NoHidden آماده است. بدون تأیید شما هیچ فایلی تغییر نخواهد کرد.</sys:String>
    <sys:String x:Key="Language">زبان</sys:String>
    <sys:String x:Key="Status">وضعیت</sys:String>
    <sys:String x:Key="Error">خطا: {0}</sys:String>

    <sys:String x:Key="ApplicationAlreadyRunning">NoHidden هم‌اکنون در حال اجرا است.</sys:String>

    <sys:String x:Key="AdminPermissionTitle">دسترسی مدیر سیستم لازم است</sys:String>
    <sys:String x:Key="AdminPermissionSubtitle">برای تغییر تنظیمات محافظتی ویندوز</sys:String>
    <sys:String x:Key="AdminPermissionDescription">برای غیرفعال کردن AutoRun و AutoPlay در سطح سیستم، NoHidden باید یک‌بار با مجوز Administrator دوباره اجرا شود. پس از تأیید، برنامه بسته می‌شود، پنجره استاندارد UAC ویندوز نمایش داده می‌شود و عملیات به‌صورت خودکار ادامه پیدا می‌کند.</sys:String>
    <sys:String x:Key="AdminPermissionNote">NoHidden فقط تنظیمات مرتبط با AutoRun و AutoPlay را تغییر می‌دهد و این مرحله هیچ فایلی را روی حافظه‌های USB حذف یا ویرایش نمی‌کند.</sys:String>
    <sys:String x:Key="RestartAsAdministrator">اجرای مجدد با دسترسی ادمین</sys:String>
    <sys:String x:Key="Cancel">انصراف</sys:String>
    <sys:String x:Key="AdminPermissionCanceled">عملیات لغو شد و هیچ تنظیمی تغییر نکرد.</sys:String>
    <sys:String x:Key="AdminElevationFailed">NoHidden با دسترسی Administrator اجرا نشده است و امکان اعمال محافظت وجود ندارد.</sys:String>
    <sys:String x:Key="AdminElevationRequired">برای اعمال این تنظیمات، دسترسی Administrator لازم است.</sys:String>

    <sys:String x:Key="AntivirusDetailsTitle">جزئیات آنتی‌ویروس</sys:String>
    <sys:String x:Key="AntivirusDetailsSubtitle">اطلاعاتی که ویندوز درباره محصول امنیتی گزارش می‌کند</sys:String>
    <sys:String x:Key="AntivirusProductLabel">محصول</sys:String>
    <sys:String x:Key="AntivirusSourceLabel">منبع اطلاعات</sys:String>
    <sys:String x:Key="AntivirusSourceValue">Windows Security Center</sys:String>
    <sys:String x:Key="AntivirusStateCodeLabel">کد وضعیت فنی</sys:String>
    <sys:String x:Key="AntivirusDetailsExplanation">NoHidden از Windows Security Center برای تشخیص محصول امنیتی ثبت‌شده استفاده می‌کند. شناسایی شدن محصول یعنی ویندوز آن را به‌عنوان آنتی‌ویروس می‌شناسد؛ این مورد به‌تنهایی تضمین نمی‌کند که همه قابلیت‌های حفاظتی، به‌روزرسانی‌ها یا Real-time protection فعال هستند.</sys:String>
    <sys:String x:Key="AntivirusTechnicalNote">کد وضعیت فقط برای عیب‌یابی نمایش داده می‌شود و امتیاز سلامت یا درصد امنیت نیست.</sys:String>
    <sys:String x:Key="NoAntivirusProduct">هیچ محصولی شناسایی نشد</sys:String>
    <sys:String x:Key="NotAvailable">در دسترس نیست</sys:String>
    <sys:String x:Key="Close">بستن</sys:String>
    <sys:String x:Key="LearnMoreOnline">مطالعه بیشتر در سایت</sys:String>

    <sys:String x:Key="ScanningStatus">حافظه USB در حال بررسی است. در زمان اسکن هیچ فایلی تغییر نمی‌کند.</sys:String>
    <sys:String x:Key="ScanningProgress">{0} مورد بررسی شد — {1}</sys:String>
    <sys:String x:Key="CancelScan">توقف</sys:String>
    <sys:String x:Key="ScanSummary">{0} مورد بررسی شد · {1} یافته · {2} مورد قابل‌بازیابی · {3} مورد پرخطر</sys:String>
    <sys:String x:Key="ScanCompletedClean">بررسی کامل شد و مورد مشکوک یا فایل کاربری مخفی‌شده‌ای پیدا نشد.</sys:String>
    <sys:String x:Key="ScanCompletedWithFindings">بررسی کامل شد. پیش از هر عملیات ترمیم، یافته‌ها را مرور کنید.</sys:String>
    <sys:String x:Key="ScanCleanTitle">موردی پیدا نشد</sys:String>
    <sys:String x:Key="ScanCleanDescription">NoHidden در این بررسی فایل کاربری مخفی‌شده یا الگوی مشکوک بدافزار USB پیدا نکرد.</sys:String>
    <sys:String x:Key="ScanCanceledTitle">بررسی متوقف شد</sys:String>
    <sys:String x:Key="ScanCanceledDescription">اسکن متوقف شد و هیچ فایلی تغییر نکرد.</sys:String>
    <sys:String x:Key="ScanCanceledStatus">بررسی حافظه USB متوقف شد و هیچ فایلی تغییر نکرد.</sys:String>
    <sys:String x:Key="ScanFailedTitle">بررسی کامل نشد</sys:String>
    <sys:String x:Key="ScanFailedDescription">مطمئن شوید حافظه USB همچنان متصل و قابل‌دسترسی است و دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="RestoreVisibility">نمایش مجدد</sys:String>
    <sys:String x:Key="RestoreAllHidden">نمایش همه موارد مخفی</sys:String>
    <sys:String x:Key="VisibilityRestored">مورد انتخاب‌شده دوباره قابل‌مشاهده شد.</sys:String>
    <sys:String x:Key="VisibilityRestoredMultiple">همه موارد کاربری مخفی‌شده با موفقیت دوباره قابل‌مشاهده شدند.</sys:String>
    <sys:String x:Key="VisibilityRestorePartial">{0} مورد بازیابی شد و بازیابی {1} مورد انجام نشد.</sys:String>

    <sys:String x:Key="SeverityInfo">بازیابی</sys:String>
    <sys:String x:Key="SeverityLow">کم</sys:String>
    <sys:String x:Key="SeverityMedium">مشکوک</sys:String>
    <sys:String x:Key="SeverityHigh">پرخطر</sys:String>
    <sys:String x:Key="SeverityCritical">بحرانی</sys:String>

    <sys:String x:Key="FindingTypeHiddenItem">مورد مخفی‌شده</sys:String>
    <sys:String x:Key="FindingTypeAutorun">فایل Autorun</sys:String>
    <sys:String x:Key="FindingTypeSuspiciousScript">اسکریپت</sys:String>
    <sys:String x:Key="FindingTypeSuspiciousExecutable">فایل اجرایی</sys:String>
    <sys:String x:Key="FindingTypeDoubleExtension">پسوند دوگانه</sys:String>
    <sys:String x:Key="FindingTypeFolderMasquerading">جعل پوشه</sys:String>
    <sys:String x:Key="FindingTypeSuspiciousShortcut">میانبر</sys:String>
    <sys:String x:Key="FindingTypeUnknown">یافته</sys:String>

    <sys:String x:Key="ReasonHiddenAttributes">این مورد دارای ویژگی Hidden یا System است. NoHidden می‌تواند بدون تغییر محتوا، آن را دوباره قابل‌مشاهده کند.</sys:String>
    <sys:String x:Key="ReasonAutorunPresent">فایل autorun.inf روی حافظه USB وجود دارد. وجود این فایل به‌تنهایی به معنی بدافزار نیست، اما باید بررسی شود.</sys:String>
    <sys:String x:Key="ReasonAutorunSuspicious">فایل autorun.inf شامل دستوری برای اجرای فایل اجرایی، اسکریپت یا مفسر دستورات است.</sys:String>
    <sys:String x:Key="ReasonSuspiciousScript">این نوع اسکریپت می‌تواند دستور اجرا کند. NoHidden فقط آن را برای بررسی علامت‌گذاری می‌کند و خودکار حذفش نمی‌کند.</sys:String>
    <sys:String x:Key="ReasonSuspiciousExecutable">این فایل اجرایی در محلی قرار دارد که معمولاً توسط بدافزارهای USB سوءاستفاده می‌شود. فعلاً فقط برای بررسی علامت‌گذاری شده است.</sys:String>
    <sys:String x:Key="ReasonHiddenDangerous">این فایل اجرایی یا اسکریپت با ویژگی Hidden/System مخفی شده و این ترکیب نشانه مهمی از بدافزار USB است.</sys:String>
    <sys:String x:Key="ReasonDoubleExtension">نام فایل ابتدا شبیه سند یا فایل چندرسانه‌ای است و سپس پسوند اجرایی دارد؛ روشی رایج برای فریب کاربر.</sys:String>
    <sys:String x:Key="ReasonFolderMasquerading">فایل اجرایی یا میانبر همنام یک پوشه مجاور است و می‌تواند برای جعل ظاهر آن پوشه استفاده شود.</sys:String>
    <sys:String x:Key="ReasonSuspiciousShortcutCommand">این میانبر یکی از مفسرهای دستورات مانند CMD، PowerShell یا Windows Script Host را اجرا می‌کند.</sys:String>
    <sys:String x:Key="ReasonSuspiciousShortcutPayload">این میانبر به یک فایل مخفی، اجرایی یا اسکریپت اشاره می‌کند.</sys:String>
    <sys:String x:Key="ReasonRootShortcut">یک میانبر در ریشه حافظه USB پیدا شد. این الگو در بدافزارهای Shortcut رایج است و برای بررسی علامت‌گذاری شده است.</sys:String>
</ResourceDictionary>
