<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">NoHidden</sys:String>
    <sys:String x:Key="AppVersion">نسخه ۳.۰.۰ (در حال توسعه)</sys:String>
    <sys:String x:Key="SystemInfo">اطلاعات سیستم</sys:String>
    <sys:String x:Key="Error">خطا: {0}</sys:String>

    <sys:String x:Key="AutorunDisabled">اجرای خودکار غیرفعال است</sys:String>
    <sys:String x:Key="AutorunEnabled">اجرای خودکار فعال است</sys:String>
    <sys:String x:Key="AutoPlayEnabled">پخش خودکار فعال است</sys:String>
    <sys:String x:Key="AutoPlayDisabledGlobally">پخش خودکار غیرفعال است</sys:String>
    <sys:String x:Key="AutorunProtectionEnabled">اجرای خودکار و پخش خودکار برای کاربر فعلی ویندوز غیرفعال شدند.</sys:String>

    <sys:String x:Key="UnknownAntivirus">آنتی‌ویروس ناشناخته</sys:String>
    <sys:String x:Key="AntivirusStatus">آنتی‌ویروس شناسایی شد: {0} (وضعیت 0x{1})</sys:String>
    <sys:String x:Key="NotInstalled">Windows Security Center هیچ آنتی‌ویروسی را شناسایی نکرد.</sys:String>

    <sys:String x:Key="Messages">پیام‌ها</sys:String>
    <sys:String x:Key="OperationsGroupHeader">حافظه USB</sys:String>
    <sys:String x:Key="SelectUsbDrive">انتخاب حافظه USB:</sys:String>
    <sys:String x:Key="Problems">نتیجه اسکن</sys:String>
    <sys:String x:Key="ScanNotStarted">هنوز هیچ اسکنی انجام نشده است.</sys:String>
    <sys:String x:Key="NoRemovableDevices">در حال حاضر هیچ حافظه USB قابل‌حذفی در دسترس نیست.</sys:String>
    <sys:String x:Key="RefreshDrives">بازخوانی حافظه‌ها</sys:String>
    <sys:String x:Key="Language">زبان / Language</sys:String>

    <sys:String x:Key="ClickToDisableAutoRun">غیرفعال کردن AutoRun و AutoPlay</sys:String>
    <sys:String x:Key="ClickToLearnMoreAboutAntiVirus">چرا آنتی‌ویروس مهم است؟</sys:String>
</ResourceDictionary>
